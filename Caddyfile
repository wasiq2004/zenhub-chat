# Caddy sits BEHIND the host's existing reverse proxy, which owns 80/443 and
# terminates TLS for zenhubchat.axxeler.in. So Caddy serves plain HTTP only
# (the `http://` scheme disables Caddy's automatic Let's Encrypt — it can no
# longer reach public 80/443 to complete the ACME challenge). The host proxy
# should forward to this container's published port (default 8080) and pass the
# Host header. Caddy then forwards to the frontend nginx (SPA + /api, /uploads, /l/).
#
# To make Caddy own TLS directly instead, restore `zenhubchat.axxeler.in {` and
# publish ports 80:80 + 443:443 in docker-compose.yml.
:80 {
    reverse_proxy forgecrm-frontend:80
}
